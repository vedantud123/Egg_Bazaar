			 System.out.println(url);
			 new_tab(driver, url);
			 return url;
		 }
		 else {
			 String url=Globalconstant.domain_Url+"/"+data+"?"+state_id+"&"+load_status+"&"+price+"&"+date;
			 System.out.println(url);
			 new_tab(driver, url);
			 return url;
		 }
	 }
	 
