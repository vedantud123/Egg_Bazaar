public static String[] getLocationAndPrice(String line) {
	if (line.contains("/")) {
		line = line.split("[/]")[0];
	}
	String[] arr = line.split(" ");
	String location = arr[0];

	String price = arr[arr.length - 1];
	String regex = "\\b\\d{3}\\b";
	boolean contains3Digits = price.matches(".*" + regex + ".*");
	price = contains3Digits ? arr[arr.length - 1] : arr[arr.length - 2];
	if (price.contains("-")) {
		String[] priceArray = price.split("[-]");
		price = String.valueOf(getAverage(priceArray[0], priceArray[1]));
	}
	String[] locationAndPrice = { location, price };
	return locationAndPrice;
}

public static int getAverage(String a, String b)
   {
	return (int) ((Integer.parseInt(a) + Integer.parseInt(b)) / (double) 2);
   }
