	public static String dateformatformessage(String date) {
		String date2="";
		String inputDateStr =date ; 
		inputDateStr = inputDateStr.replaceAll("(?<=\\d)(?:st|nd|rd|th)", "");
		inputDateStr = inputDateStr + " 2024"; 

		SimpleDateFormat inputFormat = new SimpleDateFormat("dd MMMM yyyy");
		SimpleDateFormat outputFormat = new SimpleDateFormat("yyyy-MM-dd");
		try {
			Date date1 = inputFormat.parse(inputDateStr);
			date2=outputFormat.format(date1);
			System.out.println("Original Date: " + inputDateStr);
			System.out.println("Formatted Date: " + date2);
		} catch (ParseException e) {
			System.err.println("Error parsing date: " + e.getMessage());
		}
		return date2;
	}
